# ---- Persistence --------------------------------------------------------
# "local"  : JSON file store (demo mode, no credentials needed)  [default]
# "firebase": Firebase Realtime Database (requires the two variables below)
# "memory" : in-memory only (tests)
HEATGUARD_STORAGE=local
# Path to a Firebase service-account JSON file. NEVER commit this file.
FIREBASE_CREDENTIALS=
# e.g. https://<project-id>-default-rtdb.<region>.firebasedatabase.app
FIREBASE_DATABASE_URL=
# Local emulator instead of a real project (no credentials needed):
#   FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000
#   FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-heatguard
HEATGUARD_LOCAL_STORE=./data/local_store.json

# ---- Assessment -------------------------------------------------------
HEATGUARD_GUIDELINE=niosh_2016

# ---- Simulation ---------------------------------------------------------
HEATGUARD_SIM_AUTOSTART=true
# real seconds per simulated minute at 1x speed
HEATGUARD_TICK_SECONDS=3
# optional fixed seed for reproducible demos
HEATGUARD_SIM_SEED=
HEATGUARD_SEED_DEMO=true

# ---- Data quality & alerting ------------------------------------------------
HEATGUARD_STALE_SECONDS=15
HEATGUARD_ESCALATE_SECONDS=120
HEATGUARD_SUSTAINED_READINGS=10

# ---- Retention policy -------------------------------------------------------
HEATGUARD_RETAIN_READINGS=2000
HEATGUARD_RETAIN_ASSESSMENTS=5000
HEATGUARD_RETENTION_DAYS=90

# ---- Security ---------------------------------------------------------------
# If set, external stations must send header X-HeatGuard-Key with this value
HEATGUARD_INGEST_KEY=
# Comma-separated allowed CORS origins
HEATGUARD_CORS=*
